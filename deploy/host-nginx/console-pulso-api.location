# Added inside the `server` block of /etc/nginx/sites-available/console.atmosferast.com,
# before `location /`. The console calls the Pulso API on its own origin under /pulso-api
# (the trailing slash in proxy_pass removes that prefix), like /storage-api and /v1 for auth-api.
# console-web sends the superadmin's token to /pulso-api/api/v1/admin/*.
	location /pulso-api/ {
		proxy_pass http://127.0.0.1:3081/;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $auth_client_ip;
		proxy_set_header X-Forwarded-For $auth_client_ip;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 30s;
		proxy_send_timeout 30s;
	}
