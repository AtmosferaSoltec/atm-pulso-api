# Copy to .env and fill it in. The real .env is never committed.
# In production the .env lives only on the server (/opt/pulso-api/.env).

# development | production | test
APP_ENV=development
PORT=3001

# The role and schema are created by scripts/provision-db.sql.
# In production the host is the container name (atm-postgres), not localhost.
DATABASE_URL=postgres://pulso_app:CHANGE_ME@127.0.0.1:5432/pulso?sslmode=disable&search_path=pulso

# atm-auth-api owns identity: login, sessions and who may enter Pulso. The web signs in against
# it directly; this API only checks its tokens (RS256, keys at AUTH_API_URL/.well-known/jwks.json).
# On the VPS it is reachable inside the docker network.
AUTH_API_URL=http://auth-api:8080
# The `iss` of its tokens; it must match the auth-api deployment. Required in production.
AUTH_ISSUER=
# Pulso's code in atm-auth-api (console -> Sistemas).
AUTH_SYSTEM_CODE=pulso
# Secret of Pulso's service token (console -> system -> "Generar credencial"). Required in
# production. It lets this API read the companies and manage the team. Without it (development)
# company names fall back to the RUC and the team page is unavailable.
AUTH_CLIENT_SECRET=

# Browser origins allowed to call the API, separated by commas. Production:
# https://pulso.atmosferast.com. Local development: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Requests per minute per IP: the whole API, and the heavy routes (CSV export, superadmin) in particular.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# atm-identity-api resolves DNI and RUC. On the VPS it is reachable inside the docker
# network. The key is created on the server with: create-client-system pulso "Pulso".
# Without a key (development only) lookups answer invented data.
IDENTITY_API_URL=http://identity-api:8080
IDENTITY_API_KEY=

# atm-storage-api holds the company logos (uploaded in console-web). Pulso only asks it for temporary links with
# its service token (AUTH_CLIENT_SECRET). Default: http://storage-api:8084 (docker network). Local: http://localhost:8084.
# If it is down, logo_url is null and everything else keeps working.
STORAGE_API_URL=http://storage-api:8084

# Cloudflare R2: where the payment vouchers are stored. Create a PRIVATE bucket and an API token with
# read/write on that bucket only. The bucket is never exposed: the API serves the files itself.
# Required in production; in development leave them empty and the voucher endpoints answer 503.
# R2_ENDPOINT is the S3 API URL: https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
