# Copy to .env and fill it in. The real .env is never committed.
# In production the .env lives only on the server (/opt/pulso-api/.env).

# development | production | test
APP_ENV=development
PORT=3001

# The role and schema are created by scripts/provision-db.sql.
# In production the host is the container name (atm-postgres), not localhost.
DATABASE_URL=postgres://pulso_app:CHANGE_ME@127.0.0.1:5432/pulso?sslmode=disable&search_path=pulso

# Signs the access tokens (HS256). Generate it with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# How long a login lasts, in seconds. Default 28800 (8 hours, one work shift) and at most
# 86400. There is no refresh token: when it ends, the user signs in again with DNI and password.
ACCESS_TOKEN_TTL_SECONDS=28800

# Browser origins allowed to call the API directly (local development only). In
# production the web and the API share one origin through nginx, so leave it empty.
CORS_ORIGIN=http://localhost:5173

# Requests per minute per IP: the whole API, and login/password routes in particular.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# atm-identity-api resolves DNI and RUC. On the VPS it is reachable inside the docker
# network. The key is created on the server with: create-client-system pulso "Pulso".
# Without a key (development only) lookups answer invented data.
IDENTITY_API_URL=http://identity-api:8080
IDENTITY_API_KEY=

# Only for `seed-dev`: the password of the fictional demo accounts.
# SEED_PASSWORD=Pulso2026!
